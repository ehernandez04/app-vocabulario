// Esquema de la base. La cadena de conexión no vive acá: está en
// prisma7.config.ts, que la lee de DATABASE_URL (ver .env.example).
//
// El .env local apunta SIEMPRE a la rama `development` de Neon, nunca a
// `production`. En mi-presupuesto ya pasó una vez lo contrario y la API quedó
// respondiendo contra datos de prueba sin que nadie lo notara.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Quien usa la app. No hay registro: se entra con Google y solo pasan los
/// correos de la lista blanca (#28), que es lo que protege las rutas que
/// gastan dinero. Por eso no hay contraseña ni token de recuperación.
model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique
  name      String?
  image     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// La racha es parte del avance: perderla al cambiar de teléfono es lo que
  /// más duele. `lastDay` es fecha local YYYY-MM-DD, por la misma razón que
  /// `Progress.due`. Las preferencias del aparato (voz, tema, pausa) NO viajan:
  /// el tema del teléfono no tiene por qué pisar el de la tablet.
  streak  Int     @default(0)
  lastDay String? @map("last_day") @db.VarChar(10)

  words    Word[]
  progress Progress[]
  lists    List[]
  aiUsage  AiUsage[]
  push     PushSub[]

  @@map("users")
}

/// Una palabra del mazo.
///
/// `userId` nulo = palabra de fábrica, visible para todo el mundo. Con dueño =
/// privada de esa persona. Es la decisión que permite un solo camino de código
/// para las dos: las consultas filtran por `userId IN (null, yo)`.
///
/// Las de fábrica se siembran desde data/deck.json y la siembra es idempotente
/// (upsert por `en`), así que corregir una errata en el ejemplo es cambiar el
/// JSON y volver a sembrar, sin desplegar nada.
model Word {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String? @map("user_id") @db.Uuid

  en    String
  es    String
  ipa   String  @default("")
  emoji String  @default("📝")
  /// Frase de ejemplo en inglés y su traducción.
  xe    String  @default("")
  xs    String  @default("")
  /// La ilustración, cuando no es un emoji. Guarda el SVG completo: es texto y
  /// pesa menos de un kilobyte. Si está, se usa en lugar del emoji.
  svg   String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Lo que permite bajar «lo que cambió desde la última vez» (#30): cualquier
  /// edición o borrado sube esta fecha.
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Borrado con marca, no real. Un teléfono que estuvo sin señal solo se entera
  /// de que quitaste una palabra si la fila sigue ahí diciéndolo; si se borrara
  /// de verdad, ese teléfono la resucitaría al sincronizar. Solo aplica a las
  /// palabras propias: las de fábrica no se borran.
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User?      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  progress Progress[]
  audio    Audio[]
  lists    ListWord[]

  /// Nadie puede tener la misma palabra dos veces. En Postgres los nulos no
  /// chocan entre sí, así que esto no impide que dos personas tengan cada una
  /// su "to commute": solo impide que una la tenga repetida.
  @@unique([userId, en])
  @@index([userId])
  @@index([userId, updatedAt])
  @@map("words")
}

/// El avance de una persona con una palabra: cajas Leitner, cinco niveles.
///
/// `updatedAt` es la pieza de la sincronización (#30): al fusionar gana la caja
/// más alta, y a igualdad de caja, lo más reciente. Nunca se retrocede lo ya
/// aprendido.
model Progress {
  userId String @map("user_id") @db.Uuid
  wordId String @map("word_id") @db.Uuid

  box  Int    @default(1)
  /// Fecha local en YYYY-MM-DD, no un timestamp: el día de repaso se decide en
  /// la zona horaria de quien estudia. A las 11 de la noche en México, UTC ya
  /// está en el día siguiente y los repasos se adelantarían.
  due  String @db.VarChar(10)
  seen Int    @default(0)
  miss Int    @default(0)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, wordId])
  @@index([userId, due])
  @@index([userId, updatedAt])
  @@map("progress")
}

/// El audio de una palabra, por voz y por pista.
///
/// Solo vive acá el audio que se genera en caliente, o sea el de las palabras
/// que agrega cada quien. **El de las 20 de fábrica NO está en la base**: son
/// archivos en public/audio/, que el CDN cachea y el service worker precachea,
/// y así funcionan sin conexión desde el momento de instalar. Meterlos acá
/// costaría una consulta por reproducción y rompería ese precacheo.
///
/// 20 KB por pista; mil palabras serían unos 80 MB. Si algún día crece, se
/// mudan a almacenamiento de objetos sin tocar el resto del modelo.
model Audio {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId String @map("word_id") @db.Uuid

  /// Cuál de las voces grabadas: `sarah`, `eric`… Las mismas claves que usa el
  /// índice de public/audio/.
  voz   String
  /// Qué se dice: `en`, `es`, `xe` o `xs`.
  parte String @db.VarChar(2)

  mp3       Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([wordId, voz, parte])
  @@map("audio")
}

/// Una lista de palabras de una persona (#13): Básicas, Trabajo, Viajes…
///
/// El `id` lo genera el teléfono (UUID), no la base: así una lista creada sin
/// señal ya tiene su identidad y subirla dos veces es la misma operación.
/// `updatedAt` hace de versión para la sincronización, igual que en `Progress`, y
/// cualquier cambio de nombre o de miembros la sube. Borrado con marca
/// (`deletedAt`) por la misma razón que las palabras: un teléfono sin señal solo
/// se entera de que la quitaste si la fila sigue ahí diciéndolo.
model List {
  id     String @id @db.Uuid
  userId String @map("user_id") @db.Uuid
  name   String

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  words ListWord[]

  @@index([userId, updatedAt])
  @@map("lists")
}

/// Qué palabras están en qué lista. Una palabra puede estar en varias listas,
/// de fábrica o propia, y una lista en cuantas quieras: de ahí la tabla aparte.
model ListWord {
  listId String @map("list_id") @db.Uuid
  wordId String @map("word_id") @db.Uuid

  list List @relation(fields: [listId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([listId, wordId])
  @@index([wordId])
  @@map("list_words")
}

/// Cuántas veces ha usado alguien el asistente de IA en un día (#50). Es el tope
/// que protege el gasto: la ruta cuesta dinero por llamada. `day` es el día UTC en
/// YYYY-MM-DD; no hace falta que coincida con el día local de quien estudia.
model AiUsage {
  userId String @map("user_id") @db.Uuid
  day    String @db.VarChar(10)
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, day])
  @@map("ai_usage")
}

/// Un aparato suscrito al recordatorio diario (#14). Una persona puede tener
/// varios (teléfono y tablet), cada uno con su `endpoint`, que es la dirección
/// del servicio de push del navegador y por eso es única.
///
/// La hora se guarda como la eligió la persona (HH:MM) junto con su zona
/// horaria, y el cron la compara en esa zona: así sobrevive al cambio de horario
/// sin que nadie la toque. `lastSentDay` (fecha local) evita avisar dos veces el
/// mismo día aunque el cron corra varias veces dentro de la ventana.
model PushSub {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  endpoint String @unique
  p256dh   String
  auth     String
  hour     String @db.VarChar(5)
  tz       String
  lastSentDay String? @map("last_sent_day") @db.VarChar(10)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@map("push_subs")
}
