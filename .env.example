# Copiar a .env y rellenar. El .env real nunca va al repo.

# Base de datos — proyecto de Neon "app-vocabulario" (orange-cloud-70462914).
# En local apuntar SIEMPRE a la rama `development`, nunca a `production`:
#   neonctl connection-string development --project-id orange-cloud-70462914
DATABASE_URL="postgresql://usuario:clave@host.neon.tech/neondb?sslmode=require"

# Entrar con Google.
# AUTH_SECRET firma la cookie de sesión:  openssl rand -base64 33
AUTH_SECRET=
# De la consola de Google Cloud → APIs y servicios → Credenciales →
# ID de cliente de OAuth → Aplicación web. Orígenes autorizados:
#   http://localhost:3000  y  https://app-vocabulario.vercel.app
# URI de redirección autorizados (la ruta importa, no inventarla):
#   http://localhost:3000/api/auth/callback/google
#   https://app-vocabulario.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Lista blanca: quien no esté acá, no entra. Separados por coma.
# Es lo que protege las rutas que gastan dinero, no un lujo de privacidad.
# Vacía = nadie entra, a propósito: así un despliegue al que se le olvidó la
# variable queda cerrado y no abierto de par en par.
CORREOS_PERMITIDOS=

# Generar el audio del mazo: pnpm audio [voz]
ELEVENLABS_API_KEY=

# Generar tarjetas con Claude (etapa 4)
ANTHROPIC_API_KEY=
