{
  "name": "app-vocabulario",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "Repasar vocabulario inglés-español en el camino, con audio y repetición espaciada",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "next build && serwist build serwist.config.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "TZ=America/Mexico_City vitest run",
    "test:watch": "TZ=America/Mexico_City vitest",
    "icons": "python3 scripts/make-icons.py",
    "audio": "node scripts/generate-audio.mjs",
    "seed": "prisma db seed",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "serwist": "9.5.13",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@serwist/cli": "9.5.13",
    "@serwist/next": "9.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.21.1",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "unrs-resolver"
    ]
  }
}
